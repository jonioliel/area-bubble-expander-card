{
  "name": "area-bubble-expander-card",
  "version": "0.20.2",
  "description": "Two polished Home Assistant Lovelace cards for active-device monitoring and complete Area or Floor overviews, with safe controls, RTL support, and visual editors.",
  "type": "module",
  "main": "dist/area-bubble-expander-card.js",
  "files": [
    "dist",
    "docs",
    "src",
    "hacs.json",
    "README.md",
    "info.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "vite build --watch"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "rtl",
    "hebrew"
  ],
  "author": "Joni Oliel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonioliel/area-bubble-expander-card.git"
  },
  "homepage": "https://github.com/jonioliel/area-bubble-expander-card#readme",
  "bugs": {
    "url": "https://github.com/jonioliel/area-bubble-expander-card/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "lit": "^3.1.4"
  }
